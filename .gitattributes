# Normalise line endings to LF in the repository and in every checkout, so
# builds and diffs are the same on Linux, macOS and Windows.
* text=auto eol=lf

# KiCad files are text.
*.kicad_pro text
*.kicad_sch text
*.kicad_pcb text
*.kicad_sym text
*.kicad_mod text
*.kicad_dru text
*.kicad_wks text

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.step binary
*.stp binary
