# ECU bootloader. A standalone cargo workspace in this directory, built once
# per MCU family: the family is a cargo feature and decides the target.
# ./can-echo is a second workspace: the application used to test flashing
# over CAN, linked at the application offset.

# Space-separated `feature:target` pairs to build, one per MCU family,
# for example 'stm32f4:thumbv7em-none-eabihf'.
families := 'stm32g431cx:thumbv7em-none-eabi stm32g491xe:thumbv7em-none-eabi'

# Build the bootloader for one family
build feature target:
    cargo build --release --no-default-features --features {{ feature }} --target {{ target }}

# Lint the bootloader for one family
check feature target:
    cargo clippy --release --no-default-features --features {{ feature }} --target {{ target }} -- -D warnings

# Format check, then lint and build every family
ci-bootloader:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo fmt --all --check
    for pair in {{ families }}; do
        feature="${pair%%:*}" target="${pair##*:}"
        cargo clippy --release --no-default-features --features "$feature" --target "$target" -- -D warnings
        cargo build --release --no-default-features --features "$feature" --target "$target"
    done

# The linked can-echo ELF. The image tool seals it in place and writes the
# raw image for flashing over CAN next to it, as can-echo.bin.
echo := source_directory() / 'can-echo/target/thumbv7em-none-eabi/release/can-echo'

# Build the can-echo test application and seal its image
build-echo: _build-echo (_seal echo)

[working-directory('can-echo')]
_build-echo:
    cargo build --release

# The bootloader must already be on the chip: it starts can-echo after its
# wakeup window, once it has checked the sealed header.
#
# Flash the sealed can-echo through probe-rs, at the application offset
flash-echo: build-echo
    probe-rs download --chip STM32G431CB --connect-under-reset {{ echo }}
    probe-rs reset --chip STM32G431CB

# Needs the bootloader on the chip and the CAN/USB interface on this
# computer. Reset the board when the tool says so.
#
# Flash the sealed can-echo over CAN with the manager's command line
[working-directory('../..')]
flash-echo-can: build-echo
    cargo run --quiet -p manager -- flash "{{ echo }}.bin"

# Format check, lint, build and seal can-echo
ci-echo: _ci-echo (_seal echo)

[working-directory('can-echo')]
_ci-echo:
    cargo fmt --all --check
    cargo clippy --release -- -D warnings
    cargo build --release

# Fill in the image header of a linked application ELF. The tool is a host
# workspace member, so it runs from the repository root: run from here, the
# bootloader's cargo config would build it for the MCU.
[working-directory('../..')]
_seal elf:
    cargo run --quiet -p boot-image -- "{{ elf }}"

# Remove the target directories of the bootloader and can-echo
clean:
    cargo clean
    cd can-echo && cargo clean

# The bootloader for every family, and can-echo
ci-firmware: ci-bootloader ci-echo

# Everything CI runs for the bootloader
ci: ci-firmware
