# Vehicle wiring model. Recipes run in wiring/.

generated := source_directory() / '../site/static/generated/wiring'

# Validate the project with warnings as errors, and check its formatting
check:
    wirebug check --strict
    wirebug fmt --check

# Format the .wb files in place
fmt:
    wirebug fmt

# Render embeddable SVGs, manifest.json and build tables for the site
render:
    wirebug render --out {{ generated }} --embed --strict

# Export every view into a single A4 PDF in wiring/out
pdf:
    wirebug render --pdf --strict

# Serve with live reload
serve:
    wirebug serve

# Regenerate the wirebug-dsl agent skill for the installed wirebug
skill:
    wirebug skill --install claude
