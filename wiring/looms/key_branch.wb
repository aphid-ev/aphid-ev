// Aphid EV — ignition key loom.
//
// The dash-mounted starter key keeps switching the Beetle's original
// ignition circuits on its original feed. The VCM taps its IGN and CRANK
// terminals. The two leads hang off the cab harness through their own
// inline connector (a mated Deutsch DT 2-way pair) so the ~2 m key loom
// can be unplugged as one. The main run carries the female half; the key
// loom the male.

use KeySwitch from "../components/lv/key_switch.wb";
use Dt04_2p   from "../components/connectors.wb";
use Dt06_2s   from "../components/connectors.wb";

extend Vehicle {
    key: KeySwitch "Ignition key";

    // The mated pair: the main loom carries the female half, the key loom
    // the male half.
    inline ic_key "Key branch" {
        male:   Dt04_2p;
        female: Dt06_2s;
        port ign   "IGN"   pin 1;
        port crank "CRANK" pin 2;
    }

    // Cab side: key signals to the VCM.
    cable key_feed "Key signals" {
        type: "2-core";

        wire violet 0.5 "IGN"   [ic_key.ign,   vcm.ign];
        wire grey   0.5 "CRANK" [ic_key.crank, vcm.crank];
    }

    // Key loom: the ~2 m run from the branch point to the dash key switch.
    cable key_loom "Key loom" {
        type:   "2-core";
        length: 2.0;

        wire violet 0.5 "IGN"   [ic_key.ign,   key.ign];
        wire grey   0.5 "CRANK" [ic_key.crank, key.crank];
    }
}

// --- View: key loom ---
// The key-side build document: the inline's male half (crimped onto this
// loom) to the key switch's run and start terminals.

view harness "Key loom" {
    grid: 20;

    include ic_key.male at (0, 0);
    include key.x1      at (36, 0);
}

// --- View: cab side ---
// VCM to the branch point; the inline shows its female half, the housing
// crimped onto the cab loom.

view harness "Cab loom — key branch" {
    grid: 20;

    include vcm.key       at (0, 0);
    include ic_key.female at (36, 0);
}
