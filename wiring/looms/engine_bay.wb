// Aphid EV — engine-bay harness drawings.
//
// The harness views for the bundles built around the rear of the car:
// the HV distribution runs and the CAN daisy chain. This fragment adds
// no instances or wires of its own — it exists to bind the views to the
// merged Vehicle namespace.

extend Vehicle {}

// --- View: Main HV harness ---
// The HV bus as a wiring harness: each box's HV connector as a pin table,
// the shared positive/negative rails as cable bundles between them.

view harness "Main HV harness" {
    grid: 20;

    // Pack-string bundle: the series-linked batteries on the left fan into
    // the junction box's pack connector on the right, mirroring the
    // schematic's source → junction flow. The MSD is inside the front pack.
    include front.hv  at (12, 5);
    include rear.hv   at (26, 1);
    include hvjb.pack at (44, 7);

    // Distribution bundle: the junction box on the left feeds the inverter
    // and the OBC/DC-DC on the right (junction → load, same direction).
    include hvjb.inverter at (10, 17);
    include hvjb.obc      at (10, 30);
    include inv.hv        at (30, 17);
    include charger.hv    at (30, 30);
}

// --- View: CAN harness ---
// The CAN bus as a harness: each ECU's CAN connector as a pin table and
// each daisy-chain hop as its twisted-pair cable box. The connectors
// serpentine down the page, alternating sides, so every hop crosses the
// central spine and its cable box lands between its two connectors.

view harness "CAN harness" {
    grid: 20;

    // CAN2 (self-built): front BMS → rear BMS → VCM.
    include front.bms_signals at (0, 4);
    include rear.bms_signals  at (42, 4);
    include vcm.can2          at (0, 14);

    // CAN1 (OEM): VCM → OBC → inverter.
    include vcm.can1    at (42, 20);
    include charger.sig at (0, 26);
    include inv.control at (42, 32);
}

// --- View: rear LV harness ---
// The VCM's cooling and lighting connectors on the left, the pump and the
// lamps on the right. The loads ground to the body where they sit, on
// leads this view does not draw. The fan has no lead from the VCM: its
// feed comes from the rear EV fuse box.

view harness "Rear LV harness" {
    grid: 20;

    include vcm.cooling at (0, 0);
    include vcm.lights  at (0, 14);

    include pump.x1      at (44, 0);
    include bl_left.x1   at (44, 10);
    include bl_right.x1  at (44, 16);
    include bl_chmsl.x1  at (44, 22);
    include rev_light.x1 at (44, 28);
}

// --- View: powertrain signal harness ---
// The leads between the VCM, the OBC/DC-DC and the inverter: CAN1 from the
// VCM through the OBC to the inverter, the ground of each of the three
// units on its own lead to the body's ground stud, and the EV-signal link
// from the inverter's ignition input to the OBC's IGCT.

view harness "Powertrain signal harness" {
    grid: 20;

    include vcm.can1    at (0, 0);
    include vcm.lv      at (0, 10);
    include charger.sig at (44, 4);
    include inv.control at (0, 24);
    include body.x1     at (44, 20);
}
