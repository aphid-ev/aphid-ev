// Aphid EV — separate brake-sensor loom.
//
// Two brake sensors sit at the front, 15 cm apart. They hang off the cab
// loom through their own inline connector (a mated Deutsch DT 4-way pair)
// so the ~2 m brake loom can be unplugged as one. The main run's
// conductors are crimped into the female half; the brake loom carries the
// male half. Four conductors cross the branch: a feed and a switched
// signal for each sensor.
//
// The two sensors take their feeds from different fuses in different
// boxes, so one blown fuse or broken feed cannot make both channels read
// "not braking". Sensor 1 is on the always-on switch fuse in the primary
// box; sensor 2 is on the EV-relay signal fuse in the rear EV box.

use BrakeSensor from "../components/lv/brake_sensor.wb";
use Dt04_4p     from "../components/connectors.wb";
use Dt06_4s     from "../components/connectors.wb";

extend Vehicle {
    bs1: BrakeSensor "Brake sensor 1";
    bs2: BrakeSensor "Brake sensor 2";

    // The mated pair: one shared pin set, two housings. The main loom
    // carries the female half, the brake loom the male half.
    inline ic_brake "Brake branch" {
        male:   Dt04_4p;
        female: Dt06_4s;
        port feed1  "FEED1"  pin 1;
        port brake1 "BRAKE1" pin 2;
        port feed2  "FEED2"  pin 3;
        port brake2 "BRAKE2" pin 4;
    }

    // Cab side: one feed from each fuse box, brake signals to the VCM.
    cable brake_feed "Brake feed" {
        type: "4-core";

        wire red   0.75 "FEED1"  [main_fuses.sw,   ic_brake.feed1];
        wire brown 0.5  "BRAKE1" [vcm.brake_1,     ic_brake.brake1];
        wire pink  0.75 "FEED2"  [ev_fuses.ev_sig, ic_brake.feed2];
        wire grey  0.5  "BRAKE2" [vcm.brake_2,     ic_brake.brake2];
    }

    // Brake loom: the ~2 m run from the branch point to the front sensors.
    cable brake_loom "Brake loom" {
        type:   "4-core";
        length: 2.0;

        wire red   0.75 "FEED1"  [ic_brake.feed1,  bs1.b_pos];
        wire brown 0.5  "BRAKE1" [ic_brake.brake1, bs1.sig];
        wire pink  0.75 "FEED2"  [ic_brake.feed2,  bs2.b_pos];
        wire grey  0.5  "BRAKE2" [ic_brake.brake2, bs2.sig];
    }
}

// --- View: brake loom ---
// The sensor-side build document: the inline's male half (crimped onto
// this loom) feeding the two sensors' spade terminals.

view harness "Brake loom" {
    grid: 20;

    include ic_brake.male at (0, 0);
    include bs1.pwr       at (60, -9);
    include bs1.sig       at (60, -3);
    include bs2.pwr       at (60, 3);
    include bs2.sig       at (60, 9);
}

// --- View: cab side ---
// VCM to the branch point; the inline shows its female half, the housing
// crimped onto the cab loom. The fuse box feeds have no connector and are
// not drawn.

view harness "Cab loom — brake branch" {
    grid: 20;

    include vcm.brake       at (0, 0);
    include ic_brake.female at (36, 0);
}
