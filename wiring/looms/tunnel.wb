// Aphid EV — tunnel loom.
//
// The physical bundle running the length of the central tunnel between
// the two battery packs. It carries signals owned by several systems —
// safe power (lv), the CAN2 front → rear hop (can), the interlock link
// (safety), and the front pack's ground lead (lv) — which is why the
// cable lives here, with the loom, rather than in any one system file.
// Safe power comes from the VCM to the rear pack and reaches the front
// pack through this cable. Ground does the same from the body's ground
// stud.

extend Vehicle {
    cable front_rear "Front–rear loom" {
        type:   "5-core";
        length: 1.8;

        wire red 2.5 "SAFE PWR" [front.safe_pwr, rear.safe_pwr];
        twisted {
            wire white/blue 0.5 "CAN2 H" [front.can_h, rear.can_h];
            wire white/red  0.5 "CAN2 L" [front.can_l, rear.can_l];
        }
        wire green 0.5 "INTLK" [front.interlock_out, rear.interlock_in];
        wire black 6.0 "GND"   [front.gnd,           rear.gnd];
    }
}

// --- View: battery signal harness ---
// The signal leads at the battery packs: the tunnel cable front → rear and
// the interlock lead rear pack → junction box. The lead from the e-stop
// into the front pack is not drawn: the e-stop has no connector. The
// ground stud shows the rear pack's ground lead, and the VCM's CAN2
// connector the hop from the rear pack.

view harness "Battery signal harness" {
    grid: 20;

    include body.x1           at (100, 18);
    include front.bms_signals at (30, 4);
    include rear.bms_signals  at (70, 4);
    include vcm.can2          at (100, -2);
    include hvjb.intlk        at (100, 8);
}
