// Aphid EV — thermal management (coolant pump + radiator fan).
//
// A `Vehicle` fragment owning the cooling devices and their control wiring.
// The coolant pump is a smart 4-wire unit fed through its own fuse and
// relay in the rear EV fuse box and PWM-driven by the VCM, which also reads
// its tacho. The radiator fan is a plain load switched by its own relay in
// the same box. The relay-coil control nets and the grounds live in the
// 12V fragment (systems/lv.wb), as does every other 12V/ground signal.

use CoolantPump from "../components/lv/coolant_pump.wb";
use RadiatorFan from "../components/lv/radiator_fan.wb";

extend Vehicle {
    pump: CoolantPump "Coolant pump";
    fan:  RadiatorFan "Radiator fan";

    // Pump — fused, relay-switched supply plus the VCM's PWM command and
    // tacho return.
    wire red   1.5 "PUMP 12V"  [ev_fuses.pump, pump.v12];
    wire blue  0.5 "PUMP PWM"  [vcm.pump_pwm,  pump.pwm];
    wire green 0.5 "PUMP TACH" [pump.tach,     vcm.pump_tach];

    // Fan — switched, fused 12 V from its relay.
    wire red 2.5 "FAN 12V" [ev_fuses.fan, fan.v12];
}

// --- View: cooling system ---
// VCM and rear EV fuse box on the left drive the pump and fan on the
// right: the pump takes fused 12 V + PWM + tacho, the fan takes
// relay-switched 12 V. On the left the VCM's two relay controls: EV CTRL
// pulls in the pump relay together with the EV relay, FAN CTRL the fan
// relay.

view schematic "Cooling system" {
    grid: 20;

    include vcm at (10, 4) ports {
        west: ev_ctrl, fan_ctrl;
        east: pump_pwm, pump_tach;
    }

    include ev_fuses at (10, 16) ports {
        west: ev_ctrl, fan_ctrl;
        east: pump, fan;
    }

    include pump at (32, 5) ports {
        west:  pwm, tach, v12;
        south: gnd;
    }

    include fan at (32, 17) ports {
        west:  v12;
        south: gnd;
    }
}
