// Aphid EV — 12V system: distribution, chassis ground, and safe power.
//
// A `Vehicle` fragment owning the two fuse boxes and every 12V feed and ground
// wire. The DC-DC source (`charger`) and the consumers live in other
// fragments; this file owns the *signals* — 12V, ground, safe power.

use PrimaryFuseBox from "../components/lv/primary_fuse_box.wb";
use EvFuseBox      from "../components/lv/ev_fuse_box.wb";
use LvBattery      from "../components/lv/lv_battery.wb";

extend Vehicle {
    main_fuses: PrimaryFuseBox "Primary fuse box";
    ev_fuses:   EvFuseBox      "Rear EV fuse box";
    aux:        LvBattery      "12V battery";

    // --- Primary distribution ---
    // The battery and the primary box sit together under the rear seat.
    // The battery lands on the box's input stud. The DC-DC charges the
    // battery through MIDI 1, the rear EV box is fed from MIDI 2, and MIDI 3
    // feeds the Beetle's original system, which is not modelled.
    // The DC-DC lead is 35 mm² behind a 150 A MIDI fuse, sized for the
    // converter's full 1.8 kW output, about 125 A. The other 25 mm² and
    // 10 mm² gauges are placeholders until their MIDI fuse ratings are
    // chosen.

    wire red 25 [aux.pos,         main_fuses.batt];
    wire red 35 [charger.out_pos, main_fuses.dcdc];
    wire red 10 [main_fuses.ev,   ev_fuses.feed];

    // Always-on supplies for the two BMS controllers.
    wire red 2.5 [main_fuses.bms_front, front.b_pos];
    wire red 2.5 [main_fuses.bms_rear,  rear.b_pos];

    // --- Rear EV distribution ---
    // Always live: the VCM, the inverter's B+ and the OBC's SENSE.
    wire red 2.5 [ev_fuses.vcm, vcm.b_pos];
    wire red 2.5 [ev_fuses.inv, inv.b_pos];
    wire red 1.0 [ev_fuses.obc, charger.sense];

    // Switched by the EV relay: the inverter's ignition input and the
    // OBC's IGCT, so neither wakes while the car is idle. The VCM pulls
    // the relay in for driving and for charging. Brake switch 2
    // is on the same relay (looms/brake_branch.wb). The coolant pump has
    // its own relay on the same control line (systems/cooling.wb).
    wire red 1.0 [ev_fuses.ev_sig, inv.ignition, charger.igct];

    // The VCM switches the relay coils on the low side and enables the
    // DC/DC output once precharge is complete.
    wire blue 0.5 [vcm.ev_ctrl,  ev_fuses.ev_ctrl];
    wire blue 0.5 [vcm.fan_ctrl, ev_fuses.fan_ctrl];
    wire blue 0.5 [vcm.dcdc_en,  charger.dc_sw];

    // --- Safe power ---
    // VCM enables safe power when interlock OK + safety checks pass.
    // Feeds contactor high-side in both battery packs; the front pack
    // is fed through the tunnel loom (looms/tunnel.wb).

    wire red 2.5 [vcm.safe_pwr, rear.safe_pwr];

    // --- Chassis ground ---
    // Power returns share the chassis ground bus. The three grounds that sit
    // on signal connectors (OBC signal GND, inverter B-, front BMS GND) come
    // back to the VCM ground on their own leads, so the shared bus never
    // decomposes into a segment drawn across those connectors in a harness
    // view. (The rear pack grounds through the tunnel loom.)
    // The DC-DC returns through the OBC/DC-DC case, on a strap as heavy as
    // its output lead.
    wire black 35 [charger.case_gnd, aux.neg];
    wire black 6.0 [
        aux.neg,
        vcm.gnd,
        pump.gnd,
        fan.gnd,
        bl_left.gnd,
        bl_right.gnd,
        bl_chmsl.gnd,
        rev_light.gnd,
    ];
    wire black 1.0 [vcm.gnd, charger.gnd];
    wire black 2.5 [vcm.gnd, inv.b_neg];
    wire black 2.5 [vcm.gnd, front.gnd];
}

// --- View: 12V supply ---
// The battery on the primary box's input stud, the DC-DC charging it
// through MIDI 1, and MIDI 2 feeding the rear EV box. The stubs name
// what each fuse supplies.

view schematic "12V supply" {
    grid: 20;

    include charger at (4, 4) ports {
        east: out_pos, case_gnd;
    }

    include aux at (4, 14) ports {
        east: pos, neg;
    }

    include main_fuses at (24, 9) ports {
        west: dcdc, batt;
        east: ev, beetle, sw, bms_front, bms_rear, interlock;
    }

    include ev_fuses at (46, 9) ports {
        west: feed;
        east: vcm, inv, obc, ev_sig, pump, fan;
    }
}
