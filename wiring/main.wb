// Aphid EV conversion — top-level vehicle wiring
//
// The Vehicle component is authored as fragments, one file per system:
// each `systems/*.wb` extends Vehicle with the instances and wires of
// one logical system (traction, safety, 12V, CAN), and each `looms/*.wb`
// carries a physical harness bundle and its harness views. Every
// fragment merges into the flat namespace rooted here, so wires and
// views freely reference instances declared in other fragments. This
// file keeps only the root component and the whole-vehicle overview.

fragment "systems/traction.wb";
fragment "systems/safety.wb";
fragment "systems/lv.wb";
fragment "systems/can.wb";
fragment "systems/cooling.wb";
fragment "systems/lighting.wb";
fragment "systems/driver_inputs.wb";
fragment "looms/tunnel.wb";
fragment "looms/engine_bay.wb";
fragment "looms/ac_charge.wb";
fragment "looms/pedal_branch.wb";
fragment "looms/brake_branch.wb";
fragment "looms/key_branch.wb";
fragment "looms/gear_branch.wb";
use Vcm from "components/lv/vcm.wb";

component Vehicle {
    // The VCM is the one device every system touches; it lives at the root.
    vcm: Vcm "VCM";
}

// --- View: HV System Overview ---

view schematic "HV System Overview" {
    grid: 20;

    // The primary fuse box appears only as its interlock feed: a single port wired
    // into the e-stop, which is the head of the HV interlock loop.
    include main_fuses at (4, 26) ports {
        east: interlock;
    }

    include front at (25, 10) ports {
        west:  hv_neg;
        east:  hv_pos;
        south: interlock_in, safe_pwr, interlock_out;
    }

    include rear at (40, 10) ports {
        west:  hv_neg;
        east:  hv_pos;
        south: interlock_in, safe_pwr, interlock_out;
    }

    include hvjb at (55, 11) ports {
        west:  pack_pos_in, pack_neg_in;
        east:  inv_pos, inv_neg, obc_pos, obc_neg;
        south: interlock_in, interlock_out;
    }

    include inv at (80, 9) ports {
        west:  dc_pos, dc_neg;
        east:  phase_u, phase_v, phase_w;
        south: interlock_in, interlock_out;
    }

    include charger at (75, 25) ports {
        west: dc_pos, dc_neg;
    }

    include mot at (95, 9) ports {
        west: phase_u, phase_v, phase_w;
    }

    include e_stop at (20, 25) ports {
        west: interlock_out, interlock_in;
    }

    include vcm at (55, 30) ports {
        west: safe_pwr;
        east: interlock;
    }
}

// --- View: VCM I/O ---
// Every VCM port with a stub naming what it connects to: inputs and
// supplies on the left, buses and outputs on the right. The starting point
// for the I/O of the VCM board.

view schematic "VCM I/O" {
    grid: 20;

    include vcm at (20, 20) ports {
        west: b_pos, gnd, ign, crank, interlock, accel_5v, accel_1, accel_2, accel_gnd, brake_1, brake_2, d1, d2, r1, r2, park_brake, pp, lock_fb, chg_stop, inlet_gnd, pump_tach;
        east: can1_h, can1_l, can2_h, can2_l, safe_pwr, ev_ctrl, fan_ctrl, pump_pwm, dcdc_en, lock_a, lock_b, led_red, led_green, brake, reverse;
    }
}
