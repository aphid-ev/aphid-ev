// Front battery pack
// 6 cell modules in series, BMS master, 2 main contactors (pos + neg),
// a precharge contactor and resistor in parallel with the main positive
// contactor, and the MSD with the traction pack's main fuse on the
// negative leg, between the negative contactor and the pack terminal.
// The current shunt for the whole string is also on the negative leg,
// between the last module and the negative contactor.

use CellModule from "cell_module.wb";
use BmsMaster  from "bms_master.wb";
use Contactor  from "contactor.wb";
use Resistor   from "resistor.wb";
use Shunt      from "shunt.wb";
use Msd        from "../hv/msd.wb";

component FrontBattery {
    component PrechargeSystem {
        c_pre: Contactor "Precharge";
        r_pre: Resistor  "Precharge R";

        pub port in       "IN";
        pub port out      "OUT";
        pub port safe_pwr "SAFE PWR";
        pub port coil_n   "COIL-";

        wire orange 50 [in,        c_pre.in];
        wire orange 50 [c_pre.out, r_pre.a];
        wire orange 50 [r_pre.b,   out];

        wire red   1.0 [safe_pwr, c_pre.coil_p];
        wire black 1.0 [coil_n,   c_pre.coil_n];
    }

    // --- Instances ---

    module_1: CellModule "Module 1";
    module_2: CellModule "Module 2";
    module_3: CellModule "Module 3";
    module_4: CellModule "Module 4";
    module_5: CellModule "Module 5";
    module_6: CellModule "Module 6";

    bms: BmsMaster "BMS Master";

    c_pos:     Contactor       "Contactor +";
    c_neg:     Contactor       "Contactor -";
    precharge: PrechargeSystem "Precharge";
    msd:       Msd             "MSD";
    shunt:     Shunt           "Current shunt";

    // --- External interface ---

    connector hv "HV pack 2p" {
        pub port hv_pos "HV+" pin 1;
        pub port hv_neg "HV-" pin 2;
    }

    connector bms_signals "Molex MX-150" {
        pub port b_pos "B+"  pin 1;
        pub port gnd   "GND" pin 2;

        pub port safe_pwr "SAFE PWR" pin 3;

        pub port can_h "CAN H" pin 4;
        pub port can_l "CAN L" pin 5;

        pub port interlock_in  "INTLK IN"  pin 6;
        pub port interlock_out "INTLK OUT" pin 7;
    }

    // --- HV series chain with precharge ---
    // Positive side: hv_pos splits to c_pos (main) and the precharge branch
    // Both paths merge at module_1.hv_pos
    // Negative side: module_6 → shunt → c_neg → MSD → hv_neg

    wire orange 50 [hv_pos,        c_pos.in,  precharge.in];
    wire orange 50 [precharge.out, c_pos.out, module_1.hv_pos];

    wire orange 50 [module_1.hv_neg, module_2.hv_pos];
    wire orange 50 [module_2.hv_neg, module_3.hv_pos];
    wire orange 50 [module_3.hv_neg, module_4.hv_pos];
    wire orange 50 [module_4.hv_neg, module_5.hv_pos];
    wire orange 50 [module_5.hv_neg, module_6.hv_pos];
    wire orange 50 [module_6.hv_neg, shunt.a];
    wire orange 50 [shunt.b,         c_neg.in];
    wire orange 50 [c_neg.out,       msd.hv_in];
    wire orange 50 [msd.hv_out,      hv_neg];

    // --- ISO-SPI daisy chain ---
    // BMS master → module 1 → module 2 → ... → module 6 (last down unconnected)

    wire black 0.25 [bms.iso_spi_h,           module_1.iso_spi_up_h];
    wire black 0.25 [bms.iso_spi_l,           module_1.iso_spi_up_l];
    wire black 0.25 [module_1.iso_spi_down_h, module_2.iso_spi_up_h];
    wire black 0.25 [module_1.iso_spi_down_l, module_2.iso_spi_up_l];
    wire black 0.25 [module_2.iso_spi_down_h, module_3.iso_spi_up_h];
    wire black 0.25 [module_2.iso_spi_down_l, module_3.iso_spi_up_l];
    wire black 0.25 [module_3.iso_spi_down_h, module_4.iso_spi_up_h];
    wire black 0.25 [module_3.iso_spi_down_l, module_4.iso_spi_up_l];
    wire black 0.25 [module_4.iso_spi_down_h, module_5.iso_spi_up_h];
    wire black 0.25 [module_4.iso_spi_down_l, module_5.iso_spi_up_l];
    wire black 0.25 [module_5.iso_spi_down_h, module_6.iso_spi_up_h];
    wire black 0.25 [module_5.iso_spi_down_l, module_6.iso_spi_up_l];

    // --- Contactor control ---
    // Safe power feeds coil high side of all 3 contactors
    // and a monitoring input on the BMS
    // BMS low-side drivers control coil ground

    wire red   1.0 [safe_pwr,     c_pos.coil_p, c_neg.coil_p, precharge.safe_pwr, bms.safe_pwr];
    wire black 1.0 [bms.cont_1_n, c_pos.coil_n];
    wire black 1.0 [bms.cont_2_n, c_neg.coil_n];
    wire black 1.0 [bms.cont_3_n, precharge.coil_n];

    // --- HV voltage sense ---
    // The BMS measures the cell stack between the contactors and the
    // pack's output behind them. It reports both on CAN2. The two agree
    // once the contactors have closed, and a voltage on the output with
    // the contactors open shows a welded contactor.

    wire orange 0.5 [bms.pack_sense_p, module_1.hv_pos];
    wire orange 0.5 [bms.pack_sense_n, module_6.hv_neg];
    wire orange 0.5 [bms.out_sense_p,  c_pos.in];
    wire orange 0.5 [bms.out_sense_n,  c_neg.out];

    // --- Current sense ---
    // SENSE+ is the shunt's module side, so the reading is positive while
    // the pack charges.

    wire orange 0.5 [bms.shunt_p, shunt.sense_p];
    wire orange 0.5 [bms.shunt_n, shunt.sense_n];

    // --- CAN bus ---
    // Same twisted-pair colors as the vehicle bus it joins.

    wire white/blue 0.5 [can_h, bms.can_h];
    wire white/red  0.5 [can_l, bms.can_l];

    // --- 12V power ---

    wire red   2.5 [b_pos, bms.b_pos];
    wire black 2.5 [gnd,   bms.gnd];

    // --- Interlock ---
    // The loop passes through the MSD, so pulling it opens the loop.

    wire green 0.5 [interlock_in,      msd.interlock_in];
    wire green 0.5 [msd.interlock_out, interlock_out];
}

// --- View: Front Battery Detail ---

view schematic "Front Battery" {
    grid: 20;

    // The pack's external interface, drawn on the wrapping enclosure: HV
    // terminals leave east/west, safe power, 12V and CAN leave south, and
    // the interlock loop enters and leaves on the east edge, through the
    // MSD.
    enclosure {
        hv_pos at (west, 2);
        hv_neg at (east, 2);

        safe_pwr at (38, south);

        b_pos at (42, south);
        gnd   at (44, south);
        can_h at (46, south);
        can_l at (48, south);

        interlock_in  at (east, 12);
        interlock_out at (east, 16);
    }

    include c_pos at (2, 2) ports {
        west:  in;
        east:  out;
        south: coil_p, coil_n;
    }

    include precharge at (2, 14) ports {
        west:  in;
        east:  out;
        south: safe_pwr, coil_n;
    }

    include module_1 at (18, 4) ports {
        west: hv_pos, iso_spi_up_h, iso_spi_up_l;
        east: hv_neg, iso_spi_down_h, iso_spi_down_l;
    }
    include module_2 at (29, 4) ports {
        west: hv_pos, iso_spi_up_h, iso_spi_up_l;
        east: hv_neg, iso_spi_down_h, iso_spi_down_l;
    }
    include module_3 at (40, 4) ports {
        west: hv_pos, iso_spi_up_h, iso_spi_up_l;
        east: hv_neg, iso_spi_down_h, iso_spi_down_l;
    }
    include module_4 at (51, 4) ports {
        west: hv_pos, iso_spi_up_h, iso_spi_up_l;
        east: hv_neg, iso_spi_down_h, iso_spi_down_l;
    }
    include module_5 at (62, 4) ports {
        west: hv_pos, iso_spi_up_h, iso_spi_up_l;
        east: hv_neg, iso_spi_down_h, iso_spi_down_l;
    }
    include module_6 at (73, 4) ports {
        west: hv_pos, iso_spi_up_h, iso_spi_up_l;
        east: hv_neg, iso_spi_down_h, iso_spi_down_l;
    }

    include shunt at (84, 3) ports {
        west:  a;
        east:  b;
        south: sense_p, sense_n;
    }

    include c_neg at (96, 2) ports {
        west:  in;
        east:  out;
        south: coil_p, coil_n;
    }

    include msd at (108, 2) ports {
        west:  hv_in;
        east:  hv_out;
        south: interlock_in, interlock_out;
    }

    include bms at (45, 28) ports {
        west:  out_sense_p, pack_sense_p, iso_spi_l, iso_spi_h, cont_1_n, cont_3_n, safe_pwr;
        east:  shunt_p, shunt_n, pack_sense_n, out_sense_n, cont_2_n;
        south: b_pos, gnd, can_h, can_l;
    }
}

// --- View: front BMS I/O ---
// Every port of the front BMS controller with a stub naming what it
// connects to inside the pack or where it leaves the pack. The starting
// point for the I/O of the BMS board.

view schematic "Front BMS I/O" {
    grid: 20;

    include bms at (20, 10) ports {
        west: b_pos, gnd, safe_pwr, can_h, can_l;
        east: iso_spi_h, iso_spi_l, cont_1_n, cont_2_n, cont_3_n, shunt_p, shunt_n, pack_sense_p, pack_sense_n, out_sense_p, out_sense_n;
    }
}
