// Battery Management System — master board
// Communicates with slaves via daisy-chained ISO-SPI,
// controls up to 3 contactors (low-side drivers),
// reports on CAN bus.
//
// The high-voltage inputs are on their own connector so the board can keep
// them isolated from the low-voltage side: a shunt current sense pair, a
// voltage sense pair on the cell stack and a second voltage sense pair on
// the pack's output terminals, past the contactors. The BMS reports both
// voltages on CAN2. They agree once precharge is complete, and the VCM
// takes that decision from them. They also show a welded contactor. Both
// packs wire the two voltage sense pairs. The current shunt is in the
// front pack, so only the front BMS uses the shunt pair.

component BmsMaster {
    connector iso_spi "ISO-SPI 2p" {
        pub port iso_spi_h "ISO SPI+" pin 1;
        pub port iso_spi_l "ISO SPI-" pin 2;
    }

    connector can "CAN 4p" {
        pub port can_h "CAN H" pin 1;
        pub port can_l "CAN L" pin 2;
    }

    connector power "Power 4p" {
        pub port b_pos "B+"  pin 1;
        pub port gnd   "GND" pins [2, 3, 4];
    }

    connector hv_sense "HV sense 6p" {
        pub port shunt_p      "SHUNT+"      pin 1;
        pub port shunt_n      "SHUNT-"      pin 2;
        pub port pack_sense_p "PACK+ SENSE" pin 3;
        pub port pack_sense_n "PACK- SENSE" pin 4;
        pub port out_sense_p  "OUT+ SENSE"  pin 5;
        pub port out_sense_n  "OUT- SENSE"  pin 6;
    }

    // Low-side contactor drivers
    pub port cont_1_n "CONT1-";
    pub port cont_2_n "CONT2-";
    pub port cont_3_n "CONT3-";
}
