// Manual service disconnect
// Sits in the front battery pack, on the negative leg between the negative
// contactor and the pack terminal. It holds the traction pack's 250 A main
// fuse and carries the HV interlock loop.
//
// The part is not chosen. The candidate is the Amphenol MINI-MSD: a
// MINI-MSDM250 plug, which holds the 250 A fuse, in a MINI-MSDF000F or
// MINI-MSDF000R receptacle. The receptacle has two M6 studs for the HV
// cables and a two-way HVIL connector, MSD-HVIL-2S. The connectors below
// follow that part.

component Msd {
    component Fuse250a {
        pub port in  "IN";
        pub port out "OUT";
    }

    fuse: Fuse250a "250A fuse";

    connector hv "M6 studs" {
        pub port hv_in  "HV IN"  pin 1;
        pub port hv_out "HV OUT" pin 2;
    }

    connector intlk "MSD-HVIL-2S" {
        pub port interlock_in  "INTLK IN"  pin 1;
        pub port interlock_out "INTLK OUT" pin 2;
    }

    wire orange 50 [hv_in,    fuse.in];
    wire orange 50 [fuse.out, hv_out];

    wire green 0.5 [interlock_in, interlock_out];
}
