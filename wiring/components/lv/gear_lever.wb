// Gear lever
// The Beetle's original lever in a new mounting box, sprung to centre.
// Pushing it forward asks for a step toward R and pulling it back a step
// toward D, the order of a conventional automatic. Each direction has two
// microswitches wired as a complementary pair: switch 1 is normally open
// and switch 2 normally closed, both fed from FEED. At rest the pair reads
// (low, high) and when the lever is moved (high, low).
// Any other reading is a fault: a lost feed, an open wire or a short.
// All four lines go straight to the VCM, which keeps the R/N/D state.

component GearLever {
    connector x1 "Shifter 5p" {
        pub port feed "FEED" pin 1; // fused 12 V feed in
        pub port d1   "D1"   pin 2; // toward D, normally open
        pub port d2   "D2"   pin 3; // toward D, normally closed
        pub port r1   "R1"   pin 4; // toward R, normally open
        pub port r2   "R2"   pin 5; // toward R, normally closed
    }
}
