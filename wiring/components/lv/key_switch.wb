// Ignition key switch
// The dash-mounted starter key keeps its original job: it takes its feed
// from the Beetle's own wiring on BATT and switches the Beetle's original
// ignition circuits. That side is not modelled. The VCM taps the key's two
// outputs: IGN, live in the run position, and CRANK, live in the start
// position. There is no starter, so CRANK carries only the VCM signal.

component KeySwitch {
    connector x1 "Ignition switch 3p" {
        pub port batt  "BATT"  pin 1; // feed from the Beetle's own wiring
        pub port ign   "IGN"   pin 2; // ignition-on output (RUN)
        pub port crank "CRANK" pin 3; // crank output (START)
    }
}
