// Brake sensor
// A simple two-terminal brake switch: the brake loom feeds it 12 V on one
// spade, and it returns a switched signal to the VCM on the other. The two
// switches take their feeds from different fuses.
// Each terminal is an individual female spade (Faston), not a housing.

use FastonF63 from "../connectors.wb";

component BrakeSensor {
    connector pwr: FastonF63 {
        pub port b_pos "B+" pin 1; // 12 V feed spade
    }

    connector sig: FastonF63 {
        pub port sig "SIG" pin 1; // switched-signal spade to the VCM
    }
}
