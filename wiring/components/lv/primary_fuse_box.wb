// Primary 12V distribution box (Littelfuse XT 880073)
// Sits under the rear seat beside the 12V battery. The battery lands on
// the M8 input stud, which feeds one bus bar. Three MIDI fuses take that
// bus to M8 output studs; four small fuses take it to a 4-way FCI APEX
// 2.8 connector (housing 54200409). The stud is rated 300 A.
//
// The ports are not on connectors yet: the APEX pin order is not fixed.

component PrimaryFuseBox {
    part:         "880073";
    manufacturer: "Littelfuse";
    description:  "XT power distribution module, 3 MIDI and 4 blade fuses";

    component Fuse {
        pub port a "IN";
        pub port b "OUT";
    }

    // MIDI fuses, bolted between the bus bar and the output studs.
    f_dcdc:   Fuse "MIDI 1 DC-DC 150 A";
    f_ev:     Fuse "MIDI 2 EV box 60 A";
    f_beetle: Fuse "MIDI 3 Beetle 60 A";

    // Blade fuses, always live.
    f_sw:        Fuse "F1 Switches 5 A";
    f_bms_front: Fuse "F2 BMS front 5 A";
    f_bms_rear:  Fuse "F3 BMS rear 5 A";
    f_interlock: Fuse "F4 Interlock 3 A";

    // M8 input stud, straight to the 12V battery.
    pub port batt "BATT";

    // M8 output studs. BEETLE feeds the car's original electrical system,
    // which this model does not describe.
    pub port dcdc   "DC-DC";
    pub port ev     "EV BOX";
    pub port beetle "BEETLE";

    // Blade-fuse outputs. SW feeds the driver's switches: the gear
    // lever, the parking brake switch and brake switch 1.
    pub port sw        "SW";
    pub port bms_front "BMS F";
    pub port bms_rear  "BMS R";
    pub port interlock "INTLK";

    wire red 35 [batt, f_dcdc.a, f_ev.a, f_beetle.a, f_sw.a, f_bms_front.a, f_bms_rear.a, f_interlock.a];

    wire red 35  [f_dcdc.b,      dcdc];
    wire red 10  [f_ev.b,        ev];
    wire red 10  [f_beetle.b,    beetle];
    wire red 1.0 [f_sw.b,        sw];
    wire red 2.5 [f_bms_front.b, bms_front];
    wire red 2.5 [f_bms_rear.b,  bms_rear];
    wire red 0.5 [f_interlock.b, interlock];
}

// --- View: primary fuse box ---
// The bus bar on the left, one fuse per output.

view schematic "Primary fuse box" {
    grid: 20;

    enclosure {
        batt      at (west, 20);
        dcdc      at (east, 2);
        ev        at (east, 8);
        beetle    at (east, 14);
        sw        at (east, 20);
        bms_front at (east, 26);
        bms_rear  at (east, 32);
        interlock at (east, 38);
    }

    include f_dcdc at (14, 2) ports {
        west: a;
        east: b;
    }
    include f_ev at (14, 8) ports {
        west: a;
        east: b;
    }
    include f_beetle at (14, 14) ports {
        west: a;
        east: b;
    }
    include f_sw at (14, 20) ports {
        west: a;
        east: b;
    }
    include f_bms_front at (14, 26) ports {
        west: a;
        east: b;
    }
    include f_bms_rear at (14, 32) ports {
        west: a;
        east: b;
    }
    include f_interlock at (14, 38) ports {
        west: a;
        east: b;
    }
}
